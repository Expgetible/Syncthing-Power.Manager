Global prefsWin

Global btn_Cancel, btn_Save, panel_st, str_stURL, lbl_stURL, lbl_stAPIKey, str_stAPIKey, str_stDeviceID, lbl_stDeviceID, chk_stAPIKey, chk_stDeviceID, chk_stShowCodes, str_nwServerMAC, lbl_nwServerMAC, btn_nwLookUp, lbl_nwSubNet, str_nwSubNet, lbl_nwServerIP, str_nwServerIP, lbl_vaDbg, str_vaDbg


Procedure OpenprefsWin(x = 0, y = 0, width = 590, height = 330)
  prefsWin = OpenWindow(#PB_Any, x, y, width, height, "Syncthing Monitor Preferences", #PB_Window_SystemMenu)
  btn_Cancel = ButtonGadget(#PB_Any, 460, 280, 90, 20, "Cancel")
  GadgetToolTip(btn_Cancel, "All settings revert to the previous (if modified)")
  btn_Save = ButtonGadget(#PB_Any, 320, 280, 90, 20, "Save")
  GadgetToolTip(btn_Save, "After this, your settings are available next time you start the program")
  panel_st = PanelGadget(#PB_Any, 10, 10, 570, 240)
  AddGadgetItem(panel_st, -1, "Syncthing")
  str_stURL = StringGadget(#PB_Any, 120, 30, 130, 20, "http://127.0.0.1:8384")
  GadgetToolTip(str_stURL, "Your local host address to Syncthing")
  lbl_stURL = TextGadget(#PB_Any, 50, 30, 60, 20, "Local URL:")
  lbl_stAPIKey = TextGadget(#PB_Any, 50, 70, 150, 20, "API key")
  str_stAPIKey = StringGadget(#PB_Any, 50, 90, 480, 20, "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", #PB_String_Password)
  GadgetToolTip(str_stAPIKey, "You find it in the web GUI and settings")
  str_stDeviceID = StringGadget(#PB_Any, 50, 140, 480, 20, "XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX", #PB_String_Password)
  GadgetToolTip(str_stDeviceID, "Look up the remote device full identification")
  lbl_stDeviceID = TextGadget(#PB_Any, 50, 120, 150, 20, "Remote Device ID")
  chk_stAPIKey = CheckBoxGadget(#PB_Any, 450, 70, 80, 20, "show code")
  GadgetToolTip(chk_stAPIKey, "Only reveal in a safe environment")
  chk_stDeviceID = CheckBoxGadget(#PB_Any, 450, 120, 80, 20, "show code")
  GadgetToolTip(chk_stDeviceID, "Only reveal in a safe environment")
  chk_stShowCodes = CheckBoxGadget(#PB_Any, 400, 170, 130, 20, "Always show codes")
  GadgetToolTip(chk_stShowCodes, "Saves with prefs and can make codes visible next time")
  AddGadgetItem(panel_st, -1, "Network")
  str_nwServerMAC = StringGadget(#PB_Any, 160, 128, 140, 20, "00:00:00:00:00:00")
  GadgetToolTip(str_nwServerMAC, "Press 'Look up' to get a list of reachable MAC addresses.")
  lbl_nwServerMAC = TextGadget(#PB_Any, 20, 130, 120, 20, "Server MAC address:")
  btn_nwLookUp = ButtonGadget(#PB_Any, 400, 28, 80, 20, "Look up")
  GadgetToolTip(btn_nwLookUp, "Opens selectable list of available MAC addresses.")
  lbl_nwSubNet = TextGadget(#PB_Any, 20, 30, 120, 20, "Sub Net:")
  str_nwSubNet = StringGadget(#PB_Any, 160, 28, 140, 20, "n.n.n.")
  GadgetToolTip(str_nwSubNet, "Example: 10.0.0.255 or 10.0.0")
  lbl_nwServerIP = TextGadget(#PB_Any, 20, 80, 120, 20, "Server IP:")
  str_nwServerIP = StringGadget(#PB_Any, 160, 78, 140, 20, "n.n.n.n")
  AddGadgetItem(panel_st, -1, "Various")
  lbl_vaDbg = TextGadget(#PB_Any, 90, 38, 70, 20, "Debug level")
  str_vaDbg = StringGadget(#PB_Any, 170, 38, 30, 20, "", #PB_String_Numeric)
  CloseGadgetList()
EndProcedure


