Global lookUpWin

Global lst_lu, btn_luSelect, btn_luCancel, txt_luStatus


Procedure OpenlookUpWin(x = 200, y = 200, width = 390, height = 390)
  lookUpWin = OpenWindow(#PB_Any, x, y, width, height, "Syncthing LookUp", #PB_Window_SystemMenu | #PB_Window_WindowCentered)
  lst_lu = ListIconGadget(#PB_Any, 20, 40, 350, 290, "IP", 100, #PB_ListIcon_GridLines | #PB_ListIcon_FullRowSelect | #PB_ListIcon_AlwaysShowSelection)
  AddGadgetColumn(lst_lu, 1, "MAC", 110)
  AddGadgetColumn(lst_lu, 2, "Name", 136)
  btn_luSelect = ButtonGadget(#PB_Any, 50, 350, 90, 20, "Select")
  btn_luCancel = ButtonGadget(#PB_Any, 240, 350, 90, 20, "Cancel")
  txt_luStatus = TextGadget(#PB_Any, 20, 10, 130, 20, "Scanning...")
EndProcedure


